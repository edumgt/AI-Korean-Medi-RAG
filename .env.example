# Documents
DOCS_PATH=data/documents.jsonl

# LLM (optional): none | openai
LLM_PROVIDER=none

# OpenAI (optional)
# OPENAI_API_KEY=YOUR_KEY
OPENAI_MODEL=gpt-4o-mini

# ── SQLAlchemy (관계형 DB) ────────────────────────────────────────────────────
# SQLite (개발 기본값 – 별도 서버 불필요)
DATABASE_URL=sqlite:///./med_rag.db
# PostgreSQL 사용 시 아래 주석 해제 후 값 입력
# DATABASE_URL=postgresql+psycopg2://medrag:medrag@localhost:5432/medrag

# ── MongoDB (문서 저장소) ─────────────────────────────────────────────────────
# 미설정 시 MongoDB 기능 비활성화 (JSONL 파일만 사용)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=med_rag
